# The CFB Slate — environment template.
#
#   cp .env.example .env.local    then fill in the four that are required.
#
# Names and comments only; never commit a value into this file. Everything
# below is read somewhere in src/ or scripts/ — if you add a new process.env
# read, add it here in the same commit, because this file is the only list.
#
# The app needs exactly four to boot: the two NEXT_PUBLIC_SUPABASE_* values,
# SUPABASE_SERVICE_ROLE_KEY, and CFBD_API_KEY. Everything else has a working
# default or degrades to a feature being off.


# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL and the public anon key: Dashboard → Project Settings → API.
# Safe to expose; RLS is what protects the data (supabase/migrations/0013).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — bypasses RLS entirely. Server and scripts only; it must
# never reach the browser bundle, which is why it has no NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for the weekly pg_dump (the `backup` job). Not
# used by the app, which talks REST with the key above — so this one lives in
# GitHub Actions secrets, not here.
#
# Take the SESSION POOLER row, URI tab, from the dashboard's `Connect` button
# (not Settings → Database, which only holds pool sizing). The other two rows
# both fail and fail confusingly: Direct connection resolves an IPv6-only host
# and Actions runners are not, and the Transaction pooler on 6543 drops the
# session-level features pg_dump needs. Copy the host from the modal — the
# aws-0-/aws-1- prefix varies by provisioning date.
#   postgresql://postgres.<ref>:<password>@aws-N-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=


# ── CollegeFootballData ──────────────────────────────────────────────────────
# collegefootballdata.com/key. Tier 1+ is required, for /scoreboard and the
# weather endpoint — NOT for call volume: a full cold 2023–25 backtest backfill
# is 16 calls. We run Tier 2 (30,000/month) against ~10,000 of expected use.
CFBD_API_KEY=


# ── Anthropic ────────────────────────────────────────────────────────────────
# The editorial layer: team verdicts and the three questions per game. Absent,
# those jobs log "skipping LLM generation" and go green — the site is complete
# without them.
ANTHROPIC_API_KEY=


# ── Web push ─────────────────────────────────────────────────────────────────
# VAPID keypair: `npx web-push generate-vapid-keys`. The public half is read by
# the browser and so must carry the NEXT_PUBLIC_ prefix; there is no
# unprefixed VAPID_PUBLIC_KEY. Absent, /me hides the notifications row.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address in the push payload, per RFC 8292. Defaults to
# mailto:admin@thecfbslate.app.
VAPID_SUBJECT=


# ── Site ─────────────────────────────────────────────────────────────────────
# Absolute origin for metadataBase, OG images and group share links. Defaults
# to https://cfb-gameday.vercel.app; set it in local dev only if you are
# testing share cards.
NEXT_PUBLIC_SITE_URL=


# ── Job tuning ───────────────────────────────────────────────────────────────
# All optional; the default in parentheses is what ships. A blank value means
# "unset" and takes the default — but a value that is present and unparseable
# throws rather than being silently ignored (scripts/lib/env-num.ts).

# Season every job reads and writes (2026). The one knob that rolls the site
# over to next season.
CFB_SEASON=

# How much off/def shape carries from last season into the preseason halves
# (0.4, fitted by `backtest.ts --tune-preseason-tilts`). 0 = even split, which
# makes every week-0/1 projected total the same constant and forces totals to
# be withheld. Do not change without running the tuner.
PRESEASON_TILT_CARRY=

# CFBD call ceiling for the scoreboard loop (30000). It throttles at 80% and
# refuses to poll at 95%.
CFBD_MONTHLY_BUDGET=

# Seconds between polls while games are live (30).
SCOREBOARD_INTERVAL_SECONDS=

# Idle horizons in days: a job exits early when the next kickoff is further
# out than this. Lines (7), scoreboard (2), games sync (14 — and Mondays
# regardless). The freeze horizon (8) is how far ahead freeze looks for games.
LINES_IDLE_DAYS=
SCOREBOARD_IDLE_DAYS=
SYNC_GAMES_IDLE_DAYS=
FREEZE_HORIZON_DAYS=

# Set to 1 to bypass every idle guard, the same as passing --force. For
# dispatching a job out of season.
IDLE_OVERRIDE=


# ── Actions only ─────────────────────────────────────────────────────────────
# Dead-man ping (healthchecks.io free tier). The scheduler pings it on every
# successful run; the point is that a scheduler which silently stops firing
# alerts nobody, and GitHub only emails when a run ERRORS.
HEALTHCHECK_PING_URL=

# Note for whoever sets the Actions secrets: the repository secret is named
# SUPABASE_URL, and the workflow passes it through as NEXT_PUBLIC_SUPABASE_URL
# (.github/workflows/jobs.yml). The names differ on purpose; do not "fix" one
# without the other.
